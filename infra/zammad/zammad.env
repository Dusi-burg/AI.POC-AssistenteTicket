# Configurazione dello stack ufficiale zammad-docker-compose (fase-0.md §4 bis), passata con --env-file da zammad-up.sh.
# Si chiama zammad.env e non .env perché .env è in .gitignore. Nessun segreto: le password di default dello stack restano
# dentro la rete di Docker, e Zammad è pubblicato solo su 127.0.0.1.

# Versione fissata (V1): gli aggiornamenti di patch si fanno cambiando questo valore.
VERSION=7.2.2-0000

# Non "no": dopo la migrazione di un campo personalizzato Zammad arresta railsserver, scheduler e websocket e conta sul
# restart di Docker per farli ripartire (V5). "on-failure" non basta: lo scheduler esce con codice 0.
RESTART=unless-stopped

TZ=Europe/Rome

# Porta pubblicata solo su localhost di WSL: Windows la vede su 127.0.0.1:8080 grazie all'inoltro di localhost di WSL.
NGINX_EXPOSE_PORT=127.0.0.1:8080

# Default dello stack, esplicito: Elasticsearch occupa ~1,6 GB su 15 disponibili in WSL (V7).
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
